{
  "name": "archora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "start": "concurrently -n \"SERVER,FRONTEND\" -c \"cyan,magenta\" \"tsx server/index.ts\" \"vite\"",
    "test": "tsx server/tests/dbIntegration.test.ts && tsx server/tests/aiHistory.test.ts && tsx server/tests/fileManagement.test.ts && tsx server/tests/pdfExport.test.ts && tsx server/tests/aiUsage.test.ts && tsx server/tests/backupRestore.test.ts && tsx server/tests/googleDrive.test.ts && tsx server/tests/googleDriveStorage.test.ts && tsx server/tests/securityAndE2E.test.ts && tsx server/tests/zeroCostPolicy.test.ts && tsx server/tests/vastuVision.test.ts",
    "build": "tsc -b && vite build && node scripts/build-server.cjs",
    "build:server": "node scripts/build-server.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-archora.ps1",
    "test:windows": "powershell -ExecutionPolicy Bypass -File scripts/test-deployment.ps1",
    "test:qa": "tsx scripts/run-full-qa.ts",
    "git:sync": "powershell -ExecutionPolicy Bypass -File scripts/git-sync.ps1",
    "git:watch": "powershell -ExecutionPolicy Bypass -File scripts/watch-and-sync.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "googleapis": "^189.0.0",
    "lucide-react": "^1.16.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
