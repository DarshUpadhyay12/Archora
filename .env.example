# Archora Studio - Environment Configuration
# Copy this file to .env and configure your variables

# Google Gemini AI API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Port (Default: 5000)
PORT=5000

# Optional: SQLite Database Path Override (Defaults to D:\Archora\data\archora.db or %LOCALAPPDATA%\Archora\data\archora.db)
# DATABASE_PATH=D:\Archora\data\archora.db

# Google Drive Cloud Backup Integration (Optional)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Optional: Preferred Destination Folder for Archora Cloud Backups
GOOGLE_DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID_HERE

# Optional: Google Picker API Key (if using Google Picker for interactive folder selection)
GOOGLE_PICKER_API_KEY=
